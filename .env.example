# AgentOS Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to git — it is already in .gitignore

# ── Website API (jarifurrahim.one) ──────────────────────────────────────────
# Base URL of your website
WEBSITE_API_URL=https://jarifurrahim.one

# Restricted blog write token (scope: blog_write only)
# Get this from your website admin or generate a new one
WEBSITE_API_TOKEN=agentos-<your-token-here>

# ── AgentOS Core Settings ────────────────────────────────────────────────────
# Permission level: 1=READ_ONLY, 2=SAFE_AUTOMATION, 3=FULL_AUTOMATION, 4=MANUAL_OVERRIDE
AGENTOS_PERMISSION_LEVEL=2

# Number of snapshots to keep
AGENTOS_SNAPSHOT_HISTORY=5

# Owner name (used in memory and brand context)
AGENTOS_OWNER=G.K.M. Jarif Ur Rahim

# ── LLM API (optional — for AI-powered content generation) ──────────────────
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...

